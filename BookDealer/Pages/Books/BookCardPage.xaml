<Page x:Class="BookDealer.Pages.Books.BookCardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:BookDealer.Pages.Books"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Карточка книги">

    <Grid>
        <StackPanel Margin="20">

            <Grid Margin="15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Width="250" Height="350">

                    <Image x:Name="CoverImage" Stretch="UniformToFill"/>
                </Border>


                <StackPanel Grid.Column="1">

                    <TextBlock x:Name="TitleTB" FontSize="32" TextWrapping="Wrap"/>

                    <TextBlock x:Name="AuthorTB" FontSize="20"/>

                    <WrapPanel x:Name="GenresWP" />

                    <TextBlock Text="Описание"/>

                    <TextBlock x:Name="DescriptionTB" FontSize="20" TextWrapping="Wrap"/>

                    <StackPanel Orientation="Horizontal">

                        <Button Content="🛒В корзину" />

                        <Button Content="❤︎ В список желаний"/>

                    </StackPanel>


                    <StackPanel x:Name="AdminPanel" Orientation="Horizontal" Visibility="Collapsed">

                        <Button Content="Заморозить книгу" />

                    </StackPanel>

                </StackPanel>

            </Grid>

            <Border>

                <StackPanel>

                    <TextBlock Text="Оставить отзыв"/>

                    <TextBlock Text="Оценка" />

                    <StackPanel x:Name="StarsPanel" Orientation="Horizontal" HorizontalAlignment="Left" Margin="5">

                    </StackPanel>
                    <TextBlock Text="Текст отзыва" />

                    <TextBox x:Name="ReviewTB" Height="100" TextWrapping="Wrap" AcceptsReturn="True" />

                    <Button Content="Отправить отзыв" Margin="5,15" />

                </StackPanel>

            </Border>

            <TextBlock Text="Отзывы" FontSize="32"/>

            <ItemsControl x:Name="ReviewsIC">

                <ItemsControl.ItemTemplate>

                    <DataTemplate>

                        <Border>

                            <StackPanel>

                                <TextBlock Text="{Binding User.DisplayName}" />

                                <TextBlock Text="{Binding Rating, StringFormat=Оценка: {0}/10}" FontSize="18" />

                                <TextBlock Text="{Binding ReviewText}" TextWrapping="Wrap" FontSize="20"/>

                                <StackPanel Orientation="Horizontal">

                                    <Button Content="Пожаловаться"  Tag="{Binding}"/>
                                    <Button Content="Заморозить отзыв" Visibility="{Binding RelativeSource={RelativeSource AncestorType=Page}, Path=DataContext.IsAdminVisibility}" Tag="{Binding}"/>

                                </StackPanel>
                            </StackPanel>

                        </Border>

                    </DataTemplate>

                </ItemsControl.ItemTemplate>

            </ItemsControl>

        </StackPanel>
    </Grid>
</Page>
