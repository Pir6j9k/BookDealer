<Page x:Class="BookDealer.Pages.Auth.RegisterPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:BookDealer.Pages.Auth"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Регистрация">

    <Grid HorizontalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Style="{DynamicResource Center}">
            <TextBlock  Text="Регистрация" Style="{DynamicResource TitleText}" />
        </StackPanel>
        <StackPanel Grid.Row="1">
            <TextBlock Text="Имя" Style="{DynamicResource SideText}"/>
            <Border Style="{DynamicResource Border}">
                <TextBox x:Name="NameTbx" ToolTip="Введите имя"/>
            </Border>

            <TextBlock Text="Почта" Style="{DynamicResource SideText}"/>
            <Border Style="{DynamicResource Border}">
                <TextBox x:Name="MailTbx" ToolTip="Введите почту"/>
            </Border>

            <TextBlock Text="Логин" Style="{DynamicResource SideText}"/>
            <Border Style="{DynamicResource Border}">
                <TextBox x:Name="LoginTbx" ToolTip="Введите логин"/>
            </Border>

            <TextBlock Text="Пароль" Style="{DynamicResource SideText}" />
            <Border Style="{DynamicResource Border}">
                <PasswordBox x:Name="PassB" ToolTip="Введите пароль"/>
            </Border>

            <TextBlock Text="Повторите пароль" Style="{DynamicResource SideText}"/>
            <Border Style="{DynamicResource Border}">
                <PasswordBox x:Name="RepPassB" ToolTip="Пароли должны совпадать"/>
            </Border>

        </StackPanel>
        <Button Grid.Row="2" x:Name="CreateAccB" Content="Создать аккаунт" Click="CreateAccB_Click"/>
        <StackPanel Grid.Row="3" Orientation="Horizontal" Style="{DynamicResource Center}" ToolTip="Создание аккаунта">
            <TextBlock>
            Есть аккаунта?
            <Hyperlink NavigateUri="AuthPage.xaml">Войти</Hyperlink>
            </TextBlock>
        </StackPanel>
        <Button Grid.Row="4" x:Name="ThemeChangeBtn" Content="☯︎" ToolTip="Смена темы" Style="{DynamicResource Button6}" Click="ThemeChangeBtn_Click" />

    </Grid>
</Page>
