<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <FontFamily x:Key="GV">
        ./Resourses/Fonts/GreatVibes-Regular.ttf#Great Vibes
    </FontFamily>
    <FontFamily x:Key="PS">
        ./Resourses/Fonts/PTSerif-Regular.ttf#PT Serif
    </FontFamily>

    <Style TargetType="Grid">
        <Setter Property="Background" Value="#F7F3F2"/>
    </Style>
    <Style TargetType="Window">
        <Setter Property="Background" Value="#F7F3F2"/>
    </Style>
    <!--Main Text-->
    <Style TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="FontFamily" Value="{DynamicResource PS}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Foreground" Value="#140a0a"/>
        <Setter Property="Margin" Value="5"/>
    </Style>
    <!--Centered text-->
    <Style x:Key="CenterText" TargetType="TextBlock">
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="FontFamily" Value="{DynamicResource PS}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Foreground" Value="#140a0a"/>
        <Setter Property="Margin" Value="5"/>
    </Style>
    
    <!--Side Text-->
    <Style x:Key="SideText" TargetType="TextBlock"> 
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="FontFamily" Value="{DynamicResource PS}"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="Foreground" Value="#BCB3B3"/>
        <Setter Property="Margin" Value="15,5"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>
    <!--Side1 Text-->
    <Style x:Key="Side1Text" TargetType="TextBlock">
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="FontFamily" Value="{DynamicResource PS}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Foreground" Value="#B92F20"/>
        <Setter Property="Margin" Value="5"/>

    </Style>

    <Style x:Key="Side3Text" TargetType="TextBlock">
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="FontFamily" Value="{DynamicResource PS}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Foreground" Value="#BCB3B3"/>
        <Setter Property="Margin" Value="5"/>
    </Style>
    <!-- Main Text Box-->
    <Style TargetType="TextBox">
        <Setter Property="Width" Value="auto"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="#BCB3B3"/>
    </Style>
    

    <!--Title-->
    <Style x:Key="TitleText" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="FontFamily" Value="{DynamicResource GV}"/>
        <Setter Property="FontSize" Value="48"/>
        <Setter Property="Margin" Value="10,0"/>
        <Setter Property="Foreground" Value="#140a0a"/>
        
    </Style>
    <!--Title1-->
    <Style x:Key="Title1Text" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="FontFamily" Value="{DynamicResource GV}"/>
        <Setter Property="FontSize" Value="48"/>
        <Setter Property="Foreground" Value="#B92F20"/>
    </Style>
    

    <!-- Centered Stack panel-->
    <Style x:Key="Center" TargetType="StackPanel">
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="5"/>
        <Setter Property="Background" Value="#F7F3F2"/>
    </Style>

    
    <!--Border-->
    <Style x:Key="Border" TargetType="Border">
        <Setter Property="Margin" Value="10"/>
        <Setter Property="Padding" Value="5"/>
        <Setter Property="Width" Value="500"/>
        <Setter Property="CornerRadius" Value="7"/>
        <Setter Property="BorderBrush" Value="#BCB3B3"/>
        <Setter Property="BorderThickness" Value="0.5"/>
    </Style>
    
    <!--Button-->
    <Style TargetType="Button">
        <Setter Property="Margin" Value="10"/>
        <Setter Property="Background" Value="#B92F20"/>
        <Setter Property="Foreground" Value="#F7F3F2"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="btnBorder" 
                            Background="{TemplateBinding Background}"
                            BorderBrush="#B92F20"
                            BorderThickness="1"
                            CornerRadius="7"
                            Padding="10,5">
                        <TextBlock x:Name="Text" 
                                   Text="{TemplateBinding Content}"
                                   Foreground="{TemplateBinding Foreground}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="btnBorder" Property="Background" Value="#F7F3F2"/>
                            <Setter TargetName="Text" Property="Foreground" Value="#B92F20"/>
                            <Setter Property="Cursor" Value="Hand"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--Button2-->
    <Style x:Key="Button2" TargetType="Button">
        <Setter Property="Background" Value="#140A0A"/>
        <Setter Property="Margin" Value="10"/>
        <Setter Property="Foreground" Value="#F7F3F2"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="btnBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="#140A0A"
                            BorderThickness="1"
                            CornerRadius="7"
                            Padding="10, 5">
                        <TextBlock x:Name="Text" Text="{TemplateBinding Content}"
                                   Foreground="{TemplateBinding Foreground}"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="btnBorder" Property="Background" Value="#F7F3F2"/>
                            <Setter TargetName="Text" Property="Foreground" Value="#140A0A"/>
                            <Setter Property="Cursor" Value="Hand"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--Button3-->
    <Style x:Key="Button3" TargetType="Button">
        <Setter Property="Background" Value="#F7F3F2"/>
        <Setter Property="Margin" Value="10"/>
        <Setter Property="Foreground" Value="#140A0A"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="btnBorder" 
                            Background="{TemplateBinding Background}" 
                            BorderBrush="#140A0A"
                            BorderThickness="1"
                            CornerRadius="7"
                            Padding="10, 5">
                        <TextBlock x:Name="Text" 
                                   Text="{TemplateBinding Content}"
                                   Foreground="{TemplateBinding Foreground}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="btnBorder" Property="Background" Value="#140A0A"/>
                            <Setter TargetName="Text" Property="Foreground" Value="#F7F3F2"/>
                            <Setter Property="Cursor" Value="Hand"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
    <!--Button4-->
    <Style x:Key="Button4" TargetType="Button">
        <Setter Property="Background" Value="#F7F3F2"/>
        <Setter Property="Margin" Value="10"/>
        <Setter Property="Foreground" Value="#B92F20"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="btnBorder" 
                        Background="{TemplateBinding Background}" 
                        BorderBrush="#B92F20"
                        BorderThickness="1"
                        CornerRadius="7"
                        Padding="10, 5">
                        <TextBlock x:Name="Text" 
                               Text="{TemplateBinding Content}"
                               Foreground="{TemplateBinding Foreground}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="btnBorder" Property="Background" Value="#B92F20"/>
                            <Setter TargetName="Text" Property="Foreground" Value="#F7F3F2"/>
                            <Setter Property="Cursor" Value="Hand"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!--Button 5-->
    <Style x:Key="Button5" TargetType="Button">
        <Setter Property="Background" Value="#F7F3F2"/>
        <Setter Property="Margin" Value="10"/>
        <Setter Property="Foreground" Value="#B92F20"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <TextBlock x:Name="Text" 
                               Text="{TemplateBinding Content}"
                               Foreground="{TemplateBinding Foreground}"
                               FontSize="24"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Cursor" Value="Hand"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Button6" TargetType="Button">
        <Setter Property="Background" Value="#F7F3F2"/>
        <Setter Property="Margin" Value="10"/>
        <Setter Property="Foreground" Value="#140A0A"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <TextBlock x:Name="Text" 
                           Text="{TemplateBinding Content}"
                           Foreground="{TemplateBinding Foreground}"
                           FontSize="24"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Cursor" Value="Hand"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!--Password Box-->
    <Style TargetType="PasswordBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="#BCB3B3"/>
    </Style>
    
    <!--Hyperlink-->
    <Style TargetType="Hyperlink">
        <Setter Property="Foreground" Value="#B92F20"/>
        <Setter Property="TextDecorations" Value="None"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="TextDecorations" Value="Underline"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--Datagrid-->
    <Style TargetType="DataGrid">
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="Margin" Value="10"/>
        <Setter Property="Background" Value="#F7F3F2"/>
        <Setter Property="BorderBrush" Value="#140A0A"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="GridLinesVisibility" Value="All"/>
        <Setter Property="HorizontalGridLinesBrush" Value="#140A0A"/>
        <Setter Property="VerticalGridLinesBrush" Value="#140A0A"/>
    </Style>
    
    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="#B92F20"/>
        <Setter Property="BorderBrush" Value="#140A0A"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock Text="{Binding}"
                               FontSize="24"
                               Foreground="#F7F3F2"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"/>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="DataGridCell">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#DC8178"/>
                <Setter Property="Foreground" Value="#F7F3F2"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="#DC6054"/>
                <Setter Property="Foreground" Value="#F7F3F2"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    
    <Style TargetType="TabItem">
        <Setter Property="Background" Value="#F7F3F2"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="#140A0A"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontFamily" Value="{DynamicResource PS}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="tabbtn"
                            Background="{TemplateBinding Background}" 
                            BorderBrush="#140A0A"
                            BorderThickness="1"
                            CornerRadius="7,7,0,0">
                        <TextBlock x:Name="tabtxt"
                                   Text="{TemplateBinding Header}"
                                   FontSize="24"
                                   Foreground="{TemplateBinding Foreground}"
                                   FontFamily="{DynamicResource GV}"
                                   Padding="5"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="true">
                            <Setter Property="Background" Value="#B92F20"/>
                            <Setter TargetName="tabbtn" Property="BorderBrush" Value="#B92F20"/>
                            <Setter TargetName="tabtxt" Property="Foreground" Value="#F7F3F2"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="TabControl">
        <Setter Property="Background" Value="#F7F3F2"/>
        <Setter Property="Margin" Value="5"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    
    
    <Style TargetType="Label">
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="CaptchaT" TargetType="TextBlock">
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="FontFamily" Value="{DynamicResource PS}"/>
        <Setter Property="FontSize" Value="36"/>
        <Setter Property="Foreground" Value="#B92F20"/>
        <Setter Property="Margin" Value="10"/>   
    </Style>
    <Style x:Key="CaptchaTbx" TargetType="TextBox">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Padding" Value="5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="#BCB3B3"
                            BorderThickness="0.5"
                            CornerRadius="7">
                        <TextBlock Text="{TemplateBinding Text}"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!--CheckBox-->
    <Style TargetType="CheckBox">
        <Setter Property="BorderBrush" Value="#B92F20"/>
        <Setter Property="Margin" Value="10,5"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock Text="{Binding}"
                               Margin="0"
                               Foreground="#BCB3B3"                             
                               VerticalAlignment="Center"/>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Background" Value="#F7F3F2"/>
        <Setter Property="Foreground" Value="#BCB3B3"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid Margin="10">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="#BCB3B3"
                                BorderThickness="0.5"
                                CornerRadius="7"
                                Padding="5">
                            <Grid>
                                <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                                  TextElement.Foreground="{TemplateBinding Foreground}"
                                                  VerticalAlignment="Center" 
                                                  Margin="5,0"/>
                                <TextBlock Text="▾" 
                                           Foreground="{TemplateBinding Foreground}"
                                           HorizontalAlignment="Right" 
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <ToggleButton Opacity="0" Focusable="False"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>

                        <Popup IsOpen="{TemplateBinding IsDropDownOpen}"
                               Placement="Bottom"
                               AllowsTransparency="True"
                               Focusable="False"
                               PopupAnimation="Slide">
                            <Border Background="#F7F3F2"
                                    BorderBrush="#BCB3B3"
                                    BorderThickness="0.5"
                                    CornerRadius="7"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <ScrollViewer>
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="Foreground" Value="#BCB3B3"/>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>
    
    <Style TargetType="ListBox">
        <Setter Property="Background" Value="#F7F3F2"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Margin" Value="10"/>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Bd"
                                        CornerRadius="7"
                                        Background="Transparent">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#DC8178"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#B92F20"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="#BCB3B3"
                            BorderThickness="0.5"
                            CornerRadius="7"
                            Padding="5">
                        <ScrollViewer Focusable="False">
                            <ItemsPresenter/>
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>