<Page x:Class="BookDealer.Pages.Auth.AuthPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:BookDealer.Pages.Auth"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Вход">

    <Grid HorizontalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <StackPanel  Grid.Row="0" Style="{DynamicResource Center}" Orientation="Horizontal">
            <TextBlock Text="Book" Style="{DynamicResource TitleText}"/>
            <TextBlock Text="Dealer" Style="{DynamicResource Title1Text}" />
        </StackPanel>
        <StackPanel Grid.Row="1" x:Name="logst">
            <TextBlock x:Name="LoginTb" Text="Логин" Style="{DynamicResource SideText}"/>
            <Border Style="{DynamicResource Border}">
                <TextBox x:Name="LoginTbx" ToolTip="Введите логин" />
            </Border>

            <TextBlock x:Name="PassTb" Text="Пароль" Style="{DynamicResource SideText}" />
            <Border Style="{DynamicResource Border}">
                <PasswordBox x:Name="PassPb" ToolTip="Введите пароль"/>
            </Border>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal"  Style="{DynamicResource Center}">
            <Button x:Name="GuestB" ToolTip="Войти как гость" Content="Гость" Style="{DynamicResource Button2}" Click="GuestB_Click"/>
            <Button x:Name="LoginB" Content="Войти" Click="LoginB_Click"  />
        </StackPanel>
        <StackPanel Grid.Row="3" x:Name="RegSp" Style="{DynamicResource Center}">
            <TextBlock>
            Нет аккаунта?
            <Hyperlink NavigateUri="RegisterPage.xaml" Cursor="Hand">Зарегистрироваться</Hyperlink>
            </TextBlock>
        </StackPanel>

        <StackPanel Grid.Row="4" x:Name="CapSt" Style="{DynamicResource Center}" Visibility="Collapsed">
            <Label Content="Введите символы с картинки:" x:Name="labelCaptcha"/>
            <TextBlock x:Name="captcha" ContextMenu="{x:Null}" Style="{DynamicResource CaptchaT}"/>

            <TextBox x:Name="captchaInput" ToolTip="Введите символы с картинки" Style="{DynamicResource CaptchaTbx}"/>
            <Button x:Name="submitCaptcha" Content="Подтвердить" Click="submitCaptcha_Click" ToolTip="Подтвердить ввод CAPTCHA"/>
        </StackPanel>
        <Button Grid.Row="5" x:Name="ThemeChangeBtn" Content="☯︎" ToolTip="Смена темы" Style="{DynamicResource Button6}" Click="ThemeChangeBtn_Click" />



    </Grid>
</Page>
