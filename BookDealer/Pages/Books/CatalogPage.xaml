<Page x:Class="BookDealer.Pages.Books.CatalogPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:BookDealer.Pages.Books"
      mc:Ignorable="d" 
      d:DesignHeight="1000" d:DesignWidth="1000"
      Title="Каталог">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{DynamicResource Border}" Width="225">
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Жанры" Style="{DynamicResource SideText}"/>
                    <ItemsControl x:Name="GenresList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding GenreName}" Tag="{Binding}" Click="GenreCheckBox_Click"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Цена, ₽" Style="{DynamicResource SideText}"/>
                    <StackPanel Orientation="Horizontal" Width="auto">
                        <Border Style="{DynamicResource Border}" Width="50" >
                            <TextBox x:Name="PriceFromTextBox" />
                        </Border>
                        <TextBlock Text="—" />
                        <Border Style="{DynamicResource Border}" Width="50">
                            <TextBox x:Name="PriceToTextBox"/>
                        </Border>
                    </StackPanel>

                    <TextBlock Text="Сортировка" Style="{DynamicResource SideText}"/>
                    <ComboBox x:Name="SortComboBox">
                        <ComboBoxItem Content="Популярные"/>
                        <ComboBoxItem Content="Дешевле"/>
                        <ComboBoxItem Content="Дороже"/>
                    </ComboBox>
                    <StackPanel Grid.Column="2" Orientation="Horizontal">

                        <Button x:Name="ResetFilterBtn" ToolTip="Сбросить фильтр почту" Content="Сброс" Style="{DynamicResource Button2}" Click="ResetFilterBtn_Click"/>
                        <Button x:Name="SearchButton" ToolTip="Фильтра поиска" Content="Поиск" Click="SearchButton_Click"/>
                    </StackPanel>

                </StackPanel>
            </Border>

            <ListBox x:Name="BookLb" Grid.Column="1" ToolTip="Перейти на карточку книги" Grid.ColumnSpan="2" d:ItemsSource="{d:SampleData ItemCount=5}" SelectionChanged="BookLb_SelectionChanged">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border>
                            <StackPanel>
                                <Image Source="{Binding CoverPath}" Stretch="UniformToFill"/>

                                <TextBlock Text="{Binding Title}"/>
                                <TextBlock Text="{Binding Author}" Style="{DynamicResource Side3Text}"/>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" ToolTip="Добавить книгу в корзину" Content="В корзину" Tag="{Binding}" Click="AddToCart_Click"/>
                                    <Button DockPanel.Dock="Right" ToolTip="Добавить книгу в избранное" Content="❤︎" Style="{DynamicResource Button5}" Tag="{Binding}" Click="Wishlist_Click"/>
                                    <TextBlock Text="{Binding Price, StringFormat={}{0:N0} ₽}" Style="{DynamicResource Side1Text}" VerticalAlignment="Center"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Grid>
</Page>
