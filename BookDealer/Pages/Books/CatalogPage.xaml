<Page x:Class="BookDealer.Pages.Books.CatalogPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:BookDealer.Pages.Books"
      mc:Ignorable="d" 
      d:DesignHeight="1000" d:DesignWidth="1000"
      Title="Каталог">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок и поиск -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
        </Grid>

        <!-- Фильтры и карточки -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{DynamicResource Border}" Width="225">
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Жанры" Style="{DynamicResource SideText}"/>
                    <ItemsControl x:Name="GenresList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding GenreName}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Цена, ₽" Style="{DynamicResource SideText}"/>
                    <StackPanel Orientation="Horizontal" Width="auto">
                        <Border Style="{DynamicResource Border}" Width="50" >
                            <TextBox x:Name="PriceFromTextBox" />
                        </Border>
                        <TextBlock Text="—" />
                        <Border Style="{DynamicResource Border}" Width="50">
                            <TextBox x:Name="PriceToTextBox"/>
                        </Border>
                    </StackPanel>

                    <TextBlock Text="Сортировка" Style="{DynamicResource SideText}"/>
                    <ComboBox x:Name="SortComboBox">
                        <ComboBoxItem Content="Популярные"/>
                        <ComboBoxItem Content="Дешевле"/>
                        <ComboBoxItem Content="Дороже"/>
                    </ComboBox>
                    <Button Grid.Column="2" Content="Поиск" Click="SearchButton_Click"/>

                </StackPanel>
            </Border>

            <ListBox x:Name="BookLb" Grid.Column="1" Grid.ColumnSpan="2" d:ItemsSource="{d:SampleData ItemCount=5}">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border>
                            <StackPanel>
                                <Image Source="{Binding CoverPath}" Stretch="UniformToFill"/>

                                <TextBlock Text="{Binding Title}"/>
                                <TextBlock Text="{Binding Author}" Style="{DynamicResource Side3Text}"/>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="В корзину" Tag="{Binding}" Click="AddToCart_Click"/>
                                    <Button DockPanel.Dock="Right" Content="❤︎" Style="{DynamicResource Button5}" Tag="{Binding}" Click="Wishlist_Click"/>
                                    <TextBlock Text="{Binding Price, StringFormat={}{0:N0} ₽}" Style="{DynamicResource Side1Text}" VerticalAlignment="Center"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
                      
            <!--<ScrollViewer Grid.Column="1" Grid.ColumnSpan="2" VerticalScrollBarVisibility="Visible">
                <ItemsControl x:Name="BooksList">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{DynamicResource Border}" Width="400" Padding="8">
                                <StackPanel>
                                    <Border Height="260" CornerRadius="7" Background="#140A0A" ClipToBounds="True">
                                        <Image Source="{Binding CoverPath}" Stretch="UniformToFill"/>
                                    </Border>

                                    <TextBlock Text="{Binding Title}" FontSize="20"/>
                                    <TextBlock Text="{Binding Author}" Style="{DynamicResource Side3Text}" />

                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="В корзину" Tag="{Binding}" Click="AddToCart_Click"/>
                                        <Button DockPanel.Dock="Right" Content="❤︎" Style="{DynamicResource Button5}" Tag="{Binding}" Click="Wishlist_Click"/>
                                        <TextBlock Text="{Binding Price, StringFormat={}{0:N0} ₽}" Style="{DynamicResource Side1Text}"/>
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>-->
        </Grid>
    </Grid>
</Page>
