<Window x:Class="BookDealer.Pages.Admin.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BookDealer.Pages.Admin"
        mc:Ignorable="d" Style="{DynamicResource {x:Type Window}}"
        Title="Смена пароля" Height="450" Width="800">
    <StackPanel Style="{DynamicResource Center}">
        <StackPanel Style="{DynamicResource Center}" Orientation="Horizontal">
            <TextBlock Text="Смена" Style="{DynamicResource TitleText}"/>
            <TextBlock Text="пароля" Style="{DynamicResource Title1Text}"/>
        </StackPanel>
        <StackPanel >
            <TextBlock Text="Пользователь" Style="{DynamicResource SideText}"/>
            <TextBlock x:Name="UserNameTb" Style="{DynamicResource Side1Text}"/>

            <TextBlock Text="Новый пароль" Style="{DynamicResource SideText}"/>
            <Border Style="{DynamicResource Border}">
                <PasswordBox x:Name="NewPasswordPb" ToolTip="Введите новый пароль"/>
            </Border>
            <TextBlock Text="Повторите пароль" Style="{DynamicResource SideText}"/>
            <Border Style="{DynamicResource Border}">
                <PasswordBox x:Name="ConfirmPasswordPb" ToolTip="Пароли должны совпадать"/>
            </Border>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Style="{DynamicResource Center}">
            <Button x:Name="CancelBtn" Content="Отмена" Style="{DynamicResource Button2}" IsCancel="True"/>
            <Button x:Name="SaveBtn" Content="Сохранить" Click="SaveBtn_Click"/>
        </StackPanel>
        <Button x:Name="ThemeChangeBtn" Content="☯︎" ToolTip="Смена темы" Style="{DynamicResource Button6}" Click="ThemeChangeBtn_Click" />
    </StackPanel>
</Window>
