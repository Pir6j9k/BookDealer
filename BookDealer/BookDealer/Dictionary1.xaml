<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <FontFamily x:Key="GV">
        ./Resourses/Fonts/GreatVibes-Regular.ttf#Great Vibes
    </FontFamily>
    <FontFamily x:Key="PS">
        ./Resourses/Fonts/PTSerif-Regular.ttf#PT Serif
    </FontFamily>

   <!--Main Text-->
    <Style TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="FontFamily" Value="{StaticResource PS}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Foreground" Value="#140a0a"/>
        <Setter Property="Margin" Value="5"/>
    </Style>
    <!--Centered text-->
    <Style x:Key="CenterText" TargetType="TextBlock">
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="FontFamily" Value="{StaticResource PS}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Foreground" Value="#140a0a"/>
        <Setter Property="Margin" Value="5"/>
    </Style>
    
    <!--Side Text-->
    <Style x:Key="SideText" TargetType="TextBlock"> 
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="FontFamily" Value="{StaticResource PS}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Foreground" Value="#BCB3B3"/>
        <Setter Property="Margin" Value="15,0"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>
    <!--Side1 Text-->
    <Style x:Key="Side1Text" TargetType="TextBlock">
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="FontFamily" Value="{StaticResource PS}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Foreground" Value="#B92F20"/>
        <Setter Property="Margin" Value="5"/>

    </Style>

    <!-- Main Text Box-->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="#BCB3B3"/>
    </Style>
    

    <!--Title-->
    <Style x:Key="TitleText" TargetType="TextBlock">
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="FontFamily" Value="{StaticResource GV}"/>
        <Setter Property="FontSize" Value="48"/>
        <Setter Property="Foreground" Value="#140a0a"/>
        
    </Style>
    <!--Title1-->
    <Style x:Key="Title1Text" TargetType="TextBlock">
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="FontFamily" Value="{StaticResource GV}"/>
        <Setter Property="FontSize" Value="48"/>
        <Setter Property="Foreground" Value="#B92F20"/>
    </Style>
    

    <!-- Centered Stack panel-->
    <Style x:Key="Center" TargetType="StackPanel">
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="5"/>
    </Style>

    
    <!--Border-->
    <Style x:Key="Border" TargetType="Border">
        <Setter Property="Margin" Value="10,5"/>
        <Setter Property="Padding" Value="5"/>
        <Setter Property="CornerRadius" Value="7"/>
        <Setter Property="BorderBrush" Value="#BCB3B3"/>
        <Setter Property="BorderThickness" Value="0.5"/>
    </Style>
    <!--Button Border-->
    <Style x:Key="ButtonBorder" TargetType="Border">
        <Setter Property="Margin" Value="10,5"/>
        <Setter Property="CornerRadius" Value="7"/>
        <Setter Property="BorderBrush" Value="#B92F20"/>
        <Setter Property="BorderThickness" Value="0.5"/>
        <Setter Property="Background" Value="#B92F20"/>
        <Setter Property="Width" Value="200"/>

    </Style>
    <!--Button-->
    <Style TargetType="Button">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="Transparent"/>
        <Setter Property="FontFamily" Value="{StaticResource PS}"/>

        <Setter Property="Background" Value="#B92F20"/>
        <Setter Property="Margin" Value="5"/>
    </Style>

    <!--Button2 Border-->
    <Style x:Key="Button2Border" TargetType="Border">
        <Setter Property="Margin" Value="10,5"/>
        <Setter Property="CornerRadius" Value="7"/>
        <Setter Property="BorderBrush" Value="#140A0A"/>
        <Setter Property="BorderThickness" Value="0.5"/>
        <Setter Property="Background" Value="#140A0A"/>
        <Setter Property="Width" Value="200"/>

    </Style>
    <!--Button-->
    <Style x:Key="Button2" TargetType="Button">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="Wheat"/>
        <Setter Property="Background" Value="#140A0A"/>
        <Setter Property="Margin" Value="5"/>
    </Style>
    <!--Password Box-->
    <Style TargetType="PasswordBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="#BCB3B3"/>
    </Style>
    
    <!--Hyperlink-->
    <Style TargetType="Hyperlink">
        <Setter Property="Foreground" Value="#B92F20"/>
        <Setter Property="TextDecorations" Value="None"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="TextDecorations" Value="Underline"/>
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>